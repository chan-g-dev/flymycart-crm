# ================================================================
# FLY MY CART CRM - PRODUCTION ENVIRONMENT VARIABLES (.env)
# ================================================================

# Environment & Server
ENVIRONMENT=production
DEBUG=false
SECRET_KEY=d9ae8bdd1fb087615947b2145760f988

# Database (Supabase PostgreSQL 16):
# Replace [YOUR-PASSWORD] with your actual Supabase DB password
DATABASE_URL=postgresql://postgres.ftwjlunfjuzgfvwqmyqo:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?sslmode=require
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800

# Cloud Storage: Supabase Storage (Default & Active)
STORAGE_PROVIDER=supabase
SUPABASE_URL=https://ftwjlunfjuzgfvwqmyqo.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_BUCKET=fly-my-cart-files

# Cloudflare R2 Storage (Optional future switch - just set STORAGE_PROVIDER=r2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=fly-my-cart-production

# Set these in the hosting dashboard (production ignores local dotenv files).
FRONTEND_URL=https://crm.flymycart.in
# Required on first startup or when replacing the old default admin password.
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-password-at-least-16-characters
